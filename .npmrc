# Supply Chain Protection
min-release-age=7

# npm 12+ defaults to allow-git=none; this repo declares github: deps in package.json.
allow-git=root

# Private git deps (github:BellevueCollege/...) — set GITHUB_PAT in CI and locally when needed.
//github.com/:_authToken=${GITHUB_PAT}

@fortawesome:registry=https://npm.fontawesome.com/
@awesome.me:registry=https://npm.fontawesome.com/
//npm.fontawesome.com/:_authToken=${FONTAWESOME_KEY}
