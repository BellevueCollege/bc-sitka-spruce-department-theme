<?xml version="1.0"?>
<ruleset name="BC Sitka Spruce Theme">
	<description>PHP_CodeSniffer rules for the BC Sitka Spruce department theme.</description>

	<file>.</file>

	<arg name="extensions" value="php"/>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/css/*</exclude-pattern>
	<exclude-pattern>*/artifacts/*</exclude-pattern>

	<config name="testVersion" value="8.2-8.5"/>
	<config name="minimum_supported_wp_version" value="7.0"/>

	<rule ref="PHPCompatibilityWP"/>
</ruleset>
