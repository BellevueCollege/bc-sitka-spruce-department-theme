{#
/**
 * @file
 * Bellevue template for an agenda.
 */
#}
{% extends 'system/wrapper.twig' %}

{% block content %}
    {# formatting date in banner #}
    {% set meeting_date = post.meta('meeting_date')|date('F j, Y') %}
    {% set is_special = post.meta('special_meeting') ? '(Special Meeting)' : '' %}

    <div class="flexible-page">
        {# Pass date into banner through subtitle #}
        {% include '/stories/flexible-page-intro/flexible-page-intro.twig' with {
            title: post.title,
            subtitle: meeting_date ~ ' ' ~ is_special
        } %}

        <div class="single-agendas-page container-xl py-4">
                {{ post.content }}
            
            {# Pulling in Bi-Directional Action Items #}
                {% set action_items = post.meta('related_action_items') %}
                {% if action_items %}
                    <section class="related-action-items">
                    <h2>Action Items</h2>
                        <ul>
                            {% for item in action_items %}
                                {# Convert the raw ACF data into a Timber Post object #}
                                {% set action_item = Post(item) %}
                                    <li>
                                        <a href="{{ action_item.link }}">{{ action_item.title }}</a>
                                    </li>
                            {% endfor %}
                        </ul>
                    </section>
                {% endif %}
                {# Pulling in Bi-Directional Resolutions #}
                {% set resolutions = post.meta('related_resolutions') %}
                {% if resolutions %}
                    <section class="related-resolutions">
                        <h2>Resolutions</h2>
                        <ul>
                            {% for item in resolutions %}
                                {# Convert the raw ACF data into a Timber Post object #}
                                {% set resolution = Post(item) %}
                                <li>
                                <a href="{{ resolution.link }}">{{ resolution.title }}</a>
                                </li>
                            {% endfor %}
                        </ul>
                    </section>
                {% endif %}
        </div>
    </div>
{% endblock %}