{% set profile_image_id = acf.profile_image.ID %}
{% set profile_url = row.link %}
{% set first_name = acf.first_name %}
{% set last_name = acf.last_name %}
{% set position_title = acf.position_role %}
{% set department = acf.department %}
{% set type = acf.type %}
{% set email = acf.email %}
{% set phone_number = acf.phone_number %}
{% set scheduling_link = acf.scheduling_section.schedule_appointment_link %}

<div class="row">
	<div class="col-md-3">
		{% if profile_image_id %}
			<img src="{{ get_image(profile_image_id).src('thumbnail') }}" alt="{{ __('Picture of %s %s', 'bc-sitka-spruce')|format(first_name, last_name ) }}" class="img-fluid rounded">
		{% endif %}
	</div>
	<div class="col-md-9">
		<h3 class="card-title-small"><a href="{{ profile_url }}">{{ first_name }} {{ last_name }}</a></h3>
		<div class="row">
			<div class="col-md-6">
				{% if position_title %}<p class="position-title">{{ position_title }}</p>{% endif %}
				{% if type or department %}
					<p>
						{% if type %}
							{{ type }} /
						{% endif %}
						{% if department %}
							<strong>{{ department }}</strong>
						{% endif %}
					</p>
				{% endif %}
			</div>
			<div class="col-md-6">
				<ul class="list-unstyled">
					{% if email %}
						<li>
							<i class="fa-solid fa-envelope me-2" aria-hidden="true"></i><span class="visually-hidden">{{ __('Email:', 'bc-sitka-spruce') }}</span> <a href="mailto:{{ email }}">{{ email }}</a>
						</li>
					{% endif %}
					{% if phone_number %}
						<li>
							<i class="fa-solid fa-phone-flip me-2" aria-hidden="true"></i><span class="visually-hidden">{{ __('Phone:', 'bc-sitka-spruce') }}</span> <a href="tel:{{ phone_number }}">{{ phone_number }}</a>
						</li>
					{% endif %}
					{% if scheduling_link %}
						<li>
							<a class="btn btn-primary btn-small mt-1" href="{{ scheduling_link.url }}">
								{{ scheduling_link.title|default(__('Schedule with %s', 'bc-sitka-spruce')|format(first_name)) }}
							</a>
						</li>
					{% endif %}
				</ul>
			</div>
		</div>
	</div>
</div>
