<div class="row post-list-element">
	<div class="col-sm">
		<h3><a href="{{ post.link|esc_url }}">{{ post.title|esc_html }}</a></h3>
		<p>
			{% if post.meta('summary') %}
				{{ post.meta('summary')|esc_html }}
			{% else %}
				{{ post.excerpt|esc_html }}
			{% endif %}
		</p>
		<hr>
		<p><strong>{{ __('Posted', 'bc-sitka-spruce') }} {{ post.date|date('F j, Y') }}</strong></p>
	</div>
	<div class="col-sm-auto">
		{% if post.meta('featured_media_type') == 'image_horizontal' or post.meta('featured_media_type') == 'video' %}
			{% set img = get_image( post.meta('featured_image_horizontal') ) %}
			{% if img %}
				<img src="{{ img.src('post-horiz-sm') }}" alt="{{ img.alt }}" class="img-fluid rounded">
			{% endif %}
		{% elseif post.meta('featured_media_type') == 'image_vertical' %}
			{% set img = get_image( post.meta('featured_image_vertical') ) %}
			{% if img %}
				<img src="{{ img.src('post-vert-sm') }}" alt="{{ img.alt }}" class="img-fluid rounded">
			{% endif %}
		{% endif %}
	</div>
</div>
<hr>
