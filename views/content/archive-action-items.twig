{#
/**
 * @file
 * Bellevue template for the Agendas archive list.
 */
#}
{% extends 'system/wrapper.twig' %}

{% block content %}
    <div class="flexible-page">
        {% include '/stories/flexible-page-intro/flexible-page-intro.twig' with {
            title: title|default('Action Items Archive'),
        } %}

        <div class="archive-action-item-page container-xl">
            
            {# Loop through data passed from PHP #}
            {% for year, posts in posts_by_year %}
                
                <div class="year-group">
                    <h2> {{ year }} </h2>
                    {# The List of Posts for given Year #}
                    <ul class="agenda-list">
                        {% for post in posts %}
                            <li>
                            {# Linking the title #}
                                <a href="{{ post.link }}"><strong>{{ post.title }}</strong></a>
                            {# fetching date field#}    
                                {% set raw_date = post.meta('meeting_date') ?: post.get_field('meeting_date') %}
                            {# Only show if date exists#}
                                {% if raw_date %}
                                    - <span class="text-muted">{{ raw_date|date('F j, Y') }}</span>
                                {% else %}
                                    - <span class="text-muted">{{ post.date('F j, Y') }}</span>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}