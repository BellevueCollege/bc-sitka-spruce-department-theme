{#
/**
 * @file
 * Bellevue template for a action item.
 */
#}
{% extends 'system/wrapper.twig' %}

{% block content %}
    <div class="flexible-page">
        {% include '/stories/flexible-page-intro/flexible-page-intro.twig' with {
            title: post.title,
        } %}

        <div class="action-item-single-page container-xl">
            {# Meeting Date #}
            <div class="meta-info">
                <strong>Date:</strong> {{ post.meta('date')|date('F j, Y') }}
            </div>
            <section class="content">
                {{ post.content }}
            </section>
        {# Pulling in Associated Agenda #}
            {% set agenda_id = post.meta('associated-agenda') %}
            {% if agenda_id %}
                <section class="related-agenda">
                    <h2>Associated Agenda</h2>
                    <ul>
                        {# Convert the raw ACF data into a Timber Post object #}
                        {% set agenda = Post(agenda_id) %}
                        <li>
                            <a href="{{ agenda.link }}">{{ agenda.title }}</a>
                        </li>
                    </ul>
                </section>
            {% endif %}

            {# Pulling in Related Resolution #}
            {% set resolution_id = post.meta('related_resolutions') %}
            {% if resolution_id %}
                <section class="related-resolutions">
                    <h2>Resolutions</h2>
                    <ul>
                        {#Covert raw to timber Post Obj.#}
                        {% set resolution = Post(resolution_id) %}
                        <li>
                            <a href="{{ resolution.link }}">{{ resolution.title }}</a>
                        </li>
                    </ul>
                </section>
            {% endif %}
        </div>
    </div>
{% endblock %}