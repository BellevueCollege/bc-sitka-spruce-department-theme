{#
/**
 * @file
 * Bellevue template for a resolution.
 */
#}
{% extends 'system/wrapper.twig' %}

{% block content %}
    <div class="flexible-page">
        {% include '/stories/flexible-page-intro/flexible-page-intro.twig' with {
            title: post.title,
        } %}

        <div class="resolution-single-page container-xl">
            {# Meeting Date #}
            <div class="meta-info">
                <strong>Date:</strong> {{ post.meta('date')|date('F j, Y') }}
            </div>
            <section class="content">
                {{ post.content }}
            </section>
        {# Pull in Associated Agenda #}
            {% set agenda_id = post.meta('associated_agenda') %}
            {% if agenda_id %}
                <section class="related-agenda">
                <h2>Associated Agenda</h2>
                    <ul>
                        {# Convert raw into Timber P. Obj.#}
                        {% set agenda = Post(agenda_id) %}
                        <li>
                            <a href="{{ agenda.link }}">{{ agenda.title }}</a>
                        </li>
                    </ul>
                </section>
            {% endif %}

            {# Pull in Related Action Item #}
            {% set action_item_id = post.meta('associated_action_item') %}
            {% if action_item_id %}
                <section class= "associated-action-item">
                    <h2>Action Item</h2>
                    <ul>
                        {# Convert raw ACF into Timber P. Obj. #}
                        {% set action_item = Post(action_item_id) %}
                        <li>
                            <a href="{{ action_item.link }}">{{ action_item.title }}</a>
                        </li>
                    </ul>
                </section>
            {% endif %}
        </div>
    </div>
{% endblock %}