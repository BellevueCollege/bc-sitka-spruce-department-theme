{#
/**
 * @file
 * Bellevue template for the Agendas archive list.
 */
#}
{% extends '@views/system/wrapper.twig' %}

{% block content %}
    <div class="flexible-page">
        {% include '@stories/flexible-page-intro/flexible-page-intro.twig' with {
            title: title|default('Resolutions Archive'),
        } %}

        <div class="archive-resolution-page container-xl">
            {# Loop through data passed from PHP #}
            {% for year, posts in posts_by_year %}
                
                <div class="year-group">
                    <h2> {{ year }} </h2>
                    {# The List of Posts for given Year #}
                    <ul class="agenda-list">
                        {% for post in posts %}
                            <li>
                            {# Linking the title #}
                                <a href="{{ post.link }}"><strong>{{ post.title }}</strong></a>
                            {# fetching date field#}    
                                {% if post.localized_meeting_date %}
                                    - <span class="text-muted">{{ post.localized_meeting_date }}</span>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}