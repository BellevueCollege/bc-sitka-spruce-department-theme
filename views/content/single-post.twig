{#
  * @file
  * Bellevue template for a single post page.
#}
{% extends 'system/wrapper.twig' %}

{% block content %}
	<div class="flexible-page">
		{% include '/stories/flexible-page-intro/flexible-page-intro.twig' with {
			title: blog_home_title,
			intro_text: blog_home_intro,
			breadcrumbs: breadcrumbs
		} only %}
		<div class="container-xl post-list-page mt-lg-n4">
			<div class="row">
				<div class="col-lg-4">
					{% include '/stories/post-filter-sidebar/post-filter-sidebar.twig' %}
				</div>
				<div class="col-lg-8">
					<p>
						<a class="link-accent" href="{{ blog_home_url|esc_url }}"><i class="fa-solid fa-arrow-left-long" aria-hidden="true"></i> {{ __('Back to Listing View', 'bc-sitka-spruce') }}</a>
					</p>
					<!-- Displays the Post Title -->
					<article>
						<h2>{{ post.title }}</h2>

						<!--Summary-->
						{% if summary %}
							<p class="post-summary lead">{{ summary }}</p>
						{% endif %}

						{% if featured_image_h or featured_image_v %}
							<figure class="single-post-featured-media wp-block-image">
								{% if 'image_horizontal' == featured_media_type %}
									{{ featured_image_h }}
								{% elseif 'image_vertical' == featured_media_type %}
									{{ featured_image_v }}
								{% elseif 'video' == featured_media_type and featured_video_url %}
									<a class="video-overlay" data-fancybox href="{{ featured_video_url|esc_url }}" target="_blank">
										{{ featured_image_h }}
										{% include '/stories/play-button/play-button.twig' %}
										<span class="visually-hidden">{{ __('Click to play video', 'bc-sitka-spruce') }}</span>
									</a>
								{% endif %}
								{% if caption %}
									<figcaption>{{ caption }}</figcaption>
								{% endif %}
							</figure>
						{% endif %}

						<!-- Post Content -->
						<div class="single-post-content">
							{{ post.content }}
						</div>

						<!-- Additional Details-->
						<div class="post-additional">
							<h3>{{ __('Additional Details', 'bc-sitka-spruce') }}</h3>
							<div class="row">
								<div class="col-md">
									<!--Author/ Override Author-->
									<h4>{{ __('Author', 'bc-sitka-spruce') }}</h4>
									{% if author_override %}
										<p>{{ author_override }}</p>
									{% else %}
										<p>{{ post.author.name }}</p>
									{% endif %}

									<!--ADD PUBLISHED DATE-->
									<h4>{{ __('Published', 'bc-sitka-spruce') }}</h4>
									<p>{{ post.date }}</p>
								</div>

								<!--Contact-->
								{% if contact %}
									<div class="post-additional-contact col-md-8">
										<h4>{{ __('Contact', 'bc-sitka-spruce') }}</h4>
										{% include '/stories/contact-item/contact-item.twig' with {
											first_name: contact.first_name,
											last_name: contact.last_name,
											position: contact.position,
											phone: contact.phone,
											email: contact.email,
											scheduling_link: contact.scheduling_link,
										} %}
									</div>
								{% endif %}
							</div>
						</div>
					</article>
					<!-- ADD RELATED POSTS-->
					<aside class="related-posts">
						<h2>{{ __('Related Posts', 'bc-sitka-spruce') }}</h2>
						{% if related_posts %}
							<ul>
								{% for related_post in related_posts %}
									<li>
										<a href="{{ related_post.link }}">
											{% if related_post.thumbnail %}
												<img src="{{ related_post.thumbnail.src }}" alt="{{ related_post.thumbnail.alt }}">
											{% endif %}
											<h3>{{ related_post.title }}</h3>
											<p>{{ related_post.excerpt|length > 0 ? related_post.excerpt|slice(0, 100) ~ '...' }}</p>
										</a>
									</li>
								{% endfor %}
							</ul>
						{% else %}
							<p>No related posts found.</p>
						{% endif %}
					</aside>
				</div>
			</div>
		</div>
	</div>
{% endblock %}
