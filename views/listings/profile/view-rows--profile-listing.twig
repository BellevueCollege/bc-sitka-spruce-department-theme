{#
/**
 * @file
 * Bellevue template for a view result rows.
 *
 * Available variables:
 * - view_name: The machine name of the view.
 * - rows: An array of results rows containing the following properties:
 *    - html: The rendered row html.
 *    - row: The Timber object for the row.
 */
#}

<div id="oho-views-results-{{ view_name }}" class="views__results profile-results">
	{% if rows %}
		<p class="result-count">
			{% if row_info.total_posts == row_info.total_posts_in_query %}
				{{ __('Showing %s of %s profiles', 'bc-sitka-spruce')|format(row_info.posts_shown, row_info.total_posts) }}
			{% else %}
				{{ __('Showing %s of %s profiles that match your search (%s total profiles)', 'bc-sitka-spruce')|format(row_info.posts_shown, row_info.total_posts_in_query, row_info.total_posts) }}
			{% endif %}
		</p>
		{% set last_letter = '' %}
		{% for row in rows %}
			{% if row.row.pin_profile_in_listing %}
				<div class="pinned-profile p-3 mb-3 rounded">
					{{ row.html }}
				</div>
			{% else %}
				<div class="listing__set mb-3">
					{% set current_letter = row.row.last_name|first|upper %}
					<div class="row">
						{% if last_letter != current_letter %}
							{% set last_letter = current_letter %}
							<div class="col-auto">
								<h2>{{ current_letter }}</h2>
							</div>
							<div class="col">
								<hr class="accent">
							</div>
						{% else %}
							<div class="col mb-3">
								<hr>
							</div>
						{% endif %}
					</div>
					{{ row.html }}
				</div>
			{% endif %}
		{% endfor %}
	{% else %}
		<h2>{{ __('No people matching your search.', 'bc-sitka-spruce') }}</h2>
	{% endif %}
</div>
