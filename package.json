{
  "name": "bc-sitka-spruce-department-theme",
  "version": "2.0.0",
  "description": "Bellevue College Theme for Level 3 Department Sites",
  "main": "theme.json",
  "scripts": {
    "start": "wp-scripts start --webpack-src-dir=src --output-path=assets/dist",
    "build": "npm run lint:bootstrap-imports && wp-scripts build --webpack-src-dir=src --output-path=assets/dist",
    "storybook": "concurrently \"npm run start\" \"storybook dev -p 6006\"",
    "storybook:only": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "npx chromatic --project-token=${SITKA_CHROMATIC_PROJECT_TOKEN=}",
    "lint:bootstrap-imports": "grep -rE 'bootstrap/scss' src/scss --exclude-dir=node_modules && exit 1 || exit 0",
    "playwright:install": "playwright install chromium",
    "wp-env": "wp-env",
    "env:e2e:generate": "node tests/e2e/scripts/generate-wp-env-e2e.mjs",
    "env:e2e:start": "node tests/e2e/scripts/start-wp-env-e2e.mjs",
    "env:e2e:stop": "wp-env stop --config=.wp-env.e2e.json",
    "tunnel:e2e:start": "node tests/e2e/scripts/lambdatest-tunnel.mjs start",
    "tunnel:e2e:stop": "node tests/e2e/scripts/lambdatest-tunnel.mjs stop",
    "test:e2e": "npm run test:e2e:functional && npm run test:e2e:visual",
    "test:e2e:ci": "cross-env E2E_WPENV_EXTERNAL=1 npm run test:e2e:functional && cross-env E2E_WPENV_EXTERNAL=1 E2E_LAMBDATEST_TUNNEL_AUTO=0 npm run test:e2e:visual",
    "test:e2e:functional": "playwright test --grep-invert @visual",
    "test:e2e:functional:external": "cross-env E2E_WPENV_EXTERNAL=1 playwright test --grep-invert @visual",
    "test:e2e:aria": "playwright test --grep @aria",
    "test:e2e:aria:external": "cross-env E2E_WPENV_EXTERNAL=1 playwright test --grep @aria",
    "test:e2e:aria:update": "playwright test --grep @aria --update-snapshots=changed",
    "test:e2e:aria:update:last-failed": "playwright test --grep @aria --last-failed --update-snapshots=changed",
    "test:e2e:visual": "cross-env E2E_LAMBDATEST=1 playwright test --grep @visual",
    "test:e2e:visual:external": "cross-env E2E_WPENV_EXTERNAL=1 E2E_LAMBDATEST=1 playwright test --grep @visual",
    "test:e2e:visual:update": "cross-env E2E_LAMBDATEST=1 playwright test --grep @visual --update-snapshots=changed",
    "test:e2e:visual:update:last-failed": "cross-env E2E_LAMBDATEST=1 playwright test --grep @visual --last-failed --update-snapshots=changed",
    "test:e2e:update": "npm run test:e2e:aria:update && npm run test:e2e:visual:update",
    "test:e2e:update:last-failed": "npm run test:e2e:aria:update:last-failed && npm run test:e2e:visual:update:last-failed",
    "test:e2e:update-snapshots": "npm run test:e2e:visual:update",
    "test:e2e:ui": "playwright test --ui --grep-invert @visual",
    "test:e2e:debug": "playwright test --debug --grep-invert @visual"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BellevueCollege/bc-sitka-spruce-department-theme.git"
  },
  "keywords": [
    "wordpress",
    "theme",
    "bellevuecollege"
  ],
  "prettier": "@wordpress/prettier-config",
  "author": {
    "name": "ITS Integration Team"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/BellevueCollege/bc-sitka-spruce-department-theme/issues"
  },
  "homepage": "https://github.com/BellevueCollege/bc-sitka-spruce-department-theme#readme",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "devDependencies": {
    "@awesome.me/kit-8745498039": "^1.0.7",
    "@axe-core/playwright": "^4.11.3",
    "@chromatic-com/storybook": "^5.1.2",
    "@playwright/test": "1.63.0",
    "@popperjs/core": "^2.11.8",
    "@storybook/addon-a11y": "^10.1.8",
    "@storybook/addon-docs": "^10.1.8",
    "@storybook/addon-links": "^10.1.8",
    "@storybook/html-vite": "^10.1.8",
    "@wordpress/e2e-test-utils-playwright": "^2.1.0",
    "@wordpress/env": "^11.7.0",
    "@wordpress/scripts": "^36.0.0",
    "bc-lightbox-modal": "github:BellevueCollege/bc-lightbox-modal#v1.3.1",
    "bc-theme-layer-bs5": "github:BellevueCollege/bc-theme-layer-bs5#v1.2",
    "chromatic": "^18.3.0",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "focus-trap": "^7.6.2",
    "gerillass": "^1.3.1",
    "html-entities": "^2.5.2",
    "path": "^0.12.7",
    "process": "^0.11.10",
    "sass-embedded": "^1.99.0",
    "storybook": "^10.1.8",
    "swiper": "^14.2.0",
    "twig": "^3.0.0",
    "vite-plugin-twig-drupal": "^1.7.0",
    "webpack-remove-empty-scripts": "^1.0.4"
  },
  "sideEffects": [
    "**/*.scss",
    "**/*.css",
    "src/js/**/*.js"
  ],
  "overrides": {
    "twig": "^3.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@nightwatch/nightwatch-inspector": false,
    "@parcel/watcher@2.6.0": true,
    "core-js": false,
    "core-js-pure": false,
    "unrs-resolver": false,
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true
  }
}
