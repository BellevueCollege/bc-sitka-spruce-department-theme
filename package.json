{
  "name": "bc-sitka-spruce-department-theme",
  "version": "1.9.6",
  "description": "Bellevue College Theme for Level 3 Department Sites",
  "main": "theme.json",
  "scripts": {
    "start": "wp-scripts start --webpack-src-dir=src --output-path=assets/dist",
    "build": "wp-scripts build --webpack-src-dir=src --output-path=assets/dist",
    "storybook": "concurrently \"npm run start\" \"storybook dev -p 6006\"",
    "storybook:only": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "npx chromatic --project-token=${SITKA_CHROMATIC_PROJECT_TOKEN=}",
    "playwright:install": "playwright install chromium",
    "wp-env": "wp-env",
    "env:e2e:generate": "node tests/e2e/scripts/generate-wp-env-e2e.mjs",
    "env:e2e:start": "node tests/e2e/scripts/start-wp-env-e2e.mjs",
    "env:e2e:stop": "wp-env stop --config=.wp-env.e2e.json",
    "tunnel:e2e:start": "node tests/e2e/scripts/lambdatest-tunnel.mjs start",
    "tunnel:e2e:stop": "node tests/e2e/scripts/lambdatest-tunnel.mjs stop",
    "test:e2e": "npm run test:e2e:functional && npm run test:e2e:visual",
    "test:e2e:functional": "cross-env WP_BASE_URL=http://127.0.0.1:8889 playwright test --grep-invert @visual",
    "test:e2e:functional:external": "cross-env E2E_WPENV_EXTERNAL=1 WP_BASE_URL=http://127.0.0.1:8889 playwright test --grep-invert @visual",
    "test:e2e:aria": "cross-env WP_BASE_URL=http://127.0.0.1:8889 playwright test --grep @aria",
    "test:e2e:aria:update": "cross-env WP_BASE_URL=http://127.0.0.1:8889 playwright test --grep @aria --update-snapshots=changed",
    "test:e2e:visual": "cross-env WP_BASE_URL=http://127.0.0.1:8889 E2E_LAMBDATEST=1 playwright test --grep @visual",
    "test:e2e:update-snapshots": "cross-env WP_BASE_URL=http://127.0.0.1:8889 E2E_LAMBDATEST=1 playwright test --grep @visual --update-snapshots=changed",
    "test:e2e:ui": "cross-env WP_BASE_URL=http://127.0.0.1:8889 playwright test --ui --grep-invert @visual",
    "test:e2e:debug": "cross-env WP_BASE_URL=http://127.0.0.1:8889 playwright test --debug --grep-invert @visual"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BellevueCollege/bc-sitka-spruce-department-theme.git"
  },
  "keywords": [
    "wordpress",
    "theme",
    "bellevuecollege"
  ],
  "prettier": "@wordpress/prettier-config",
  "author": {
    "name": "ITS Integration Team"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/BellevueCollege/bc-sitka-spruce-department-theme/issues"
  },
  "homepage": "https://github.com/BellevueCollege/bc-sitka-spruce-department-theme#readme",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@chromatic-com/storybook": "^5.1.2",
    "@nightwatch/vrt": "^3.5.2",
    "@playwright/test": "^1.61.0",
    "@popperjs/core": "^2.11.8",
    "@storybook/addon-a11y": "^10.1.8",
    "@storybook/addon-docs": "^10.1.8",
    "@storybook/addon-links": "^10.1.8",
    "@storybook/html-vite": "^10.1.8",
    "@wordpress/env": "^11.7.0",
    "@wordpress/scripts": "^36.0.0",
    "bc-lightbox-modal": "github:BellevueCollege/bc-lightbox-modal#v1.3.1",
    "bootstrap": "^5.3.3",
    "chromatic": "^18.3.0",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "focus-trap": "^7.6.2",
    "gerillass": "^1.3.1",
    "html-entities": "^2.5.2",
    "nightwatch": "^3.11.1",
    "path": "^0.12.7",
    "process": "^0.11.10",
    "sass-embedded": "^1.99.0",
    "storybook": "^10.1.8",
    "swiper": "^14.2.0",
    "twig": "^3.0.0",
    "vite-plugin-twig-drupal": "^1.7.0",
    "webpack-remove-empty-scripts": "^1.0.4"
  },
  "sideEffects": [
    "**/*.scss",
    "**/*.css",
    "src/js/**/*.js"
  ],
  "dependencies": {
    "@awesome.me/kit-8745498039": "^1.0.7"
  },
  "overrides": {
    "twig": "^3.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@parcel/watcher@2.6.0": true,
    "@nightwatch/nightwatch-inspector": false,
    "core-js": false,
    "core-js-pure": false,
    "unrs-resolver": false,
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true
  }
}
