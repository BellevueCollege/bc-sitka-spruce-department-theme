{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "bc-sitka-spruce/listing-section",
    "title": "Listing Section",
    "category": "sitka-sections",
    "icon": "align-pull-right",
    "description": "Template that displays a group of List Items",
    "version": "1.0.0",
    "textdomain": "bc-sitka-spruce",
    "supports": {
        "anchor": true,
        "html": false
    },
	"allowedBlocks": [
		"bc-sitka-spruce/listing-section-list-item"
	],
    "attributes": {
        "title": {
            "type": "string"
        },
        "description": {
            "type": "string"
        },
        "anchor": {
            "type": "string",
            "default": null
        }
    },
    "editorScript": "file:./index.js",
    "editorStyle": "file:./index.css",
    "style": [ "file:./style-index.css"],
    "render": "file:./render.php"
}
