{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "bc-sitka-spruce/content-and-location",
    "title": "Template: Content with Location Sidebar",
    "category": "layout",
    "icon": "align-pull-right",
    "description": "Template that displays limited-width content on the left, with a location sidebar on the right (if enabled).",
    "version": "1.0.0",
    "textdomain": "bc-sitka-spruce",
    "supports": {
        "inserter": false,
        "multiple": false,
        "html": false
    },
    "attributes": {
        "heading": {
            "type": "string"
        },
        "summary": {
            "type": "string"
        }
    },
    "editorScript": "file:./index.js",
    "editorStyle": "file:./index.css",
    "style": ["bc-sitka-spruce-style-card", "file:./style-index.css"],
    "render": "file:./render.php"
}