{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bc-sitka-spruce/tabs-section",
	"version": "1.0.0",
	"title": "Tabs Section",
	"category": "sitka-sections",
	"icon": "align-wide",
	"description": "Section with a vertical tab component. Different from normal Tabs in that it includes a title and description built in.",
	"supports": {
		"html": false
	},
	"textdomain": "bc-sitka-spruce",
	"attributes": {
		"title": {
			"type": "string",
			"default": ""
		},
		"description": {
			"type": "string",
			"default": ""
		},
		"linkTitle": {
			"type": "string",
			"default": ""
		},
		"linkUrl": {
			"type": "string",
			"default": ""
		}
	},
	"allowedBlocks": [
		"bc-sitka-spruce/tabcordion"
	],
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
