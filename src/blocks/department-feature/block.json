{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bc-sitka-spruce/department-feature",
	"version": "1.0.0",
	"title": "BC Core Site Department Feature",
	"category": "sitka-core-content",
	"icon": "heart",
	"description": "Highlight a supportive department at Bellevue College, with context about that organization and a link to more information.",
	"supports": {
		"html": false
	},
	"textdomain": "bc-sitka-spruce",
	"attributes": {
		"title": {
			"type": "string",
			"default": ""
		},
		"description": {
			"type": "string",
			"default": ""
		},
		"linkTitle": {
			"type": "string",
			"default": ""
		},
		"linkUrl": {
			"type": "string",
			"default": ""
		},
		"departmentId": {
			"type": "number",
			"default": 0
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
