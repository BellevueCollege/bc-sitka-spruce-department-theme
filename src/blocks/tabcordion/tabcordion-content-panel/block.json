{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bc-sitka-spruce/tabcordion-content-panel",
	"version": "1.0.0",
	"title": "Tabcordion Content Panel",
	"category": "layout",
	"icon": "category",
	"supports": {
		"html": false,
		"inserter": false
	},
	"parent": [
		"bc-sitka-spruce/tabcordion-content"
	],
	"textdomain": "bc-sitka-spruce",
	"attributes": {
		"tabActive": {
			"type": "boolean",
			"default": false
		},
		"tabDefault": {
			"type": "boolean",
			"default": false
		},
		"tabId": {
			"type": "string",
			"default": ""
		},
		"tabTitle": {
			"type": "string",
			"default": ""
		}
	},
	"usesContext": [
		"bc-sitka-spruce/tabcordion/allowedBlocks",
		"bc-sitka-spruce/tabcordion/blockId"
	],
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
