{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bc-sitka-spruce/support-feature",
	"version": "1.0.0",
	"title": "BC Core Site Student Support Feature",
	"category": "sitka-core-content",
	"icon": "info",
	"description": "Display one or more tabs from the main BC news site, highlighting how BC supports students from different communities.",
	"supports": {
		"html": false
	},
	"textdomain": "bc-sitka-spruce",
	"attributes": {
		"heading": {
			"type": "string",
			"default": ""
		},
		"supportPosts": {
			"type": "array",
			"default": []
		},
		"sectionId": {
			"type": "string",
			"default": ""
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
