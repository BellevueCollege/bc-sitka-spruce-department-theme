<div id="header-wrapper">
    <header 
        id="site-header"
        class="site-header container-xl menu-expanded
            {% if search_expanded %}search-expanded{% endif %}
            {% if menu_expanded %}menu-expanded{% endif %}
    ">
        <div id="site-header--logo" class="">
            <a href="{{ core_homepage_url }}"><img class="img-fluid" src="{{ logo_url }}" alt="{{ __('Bellevue College - Link to college homepage', 'bc-sitka-spruce') }}"></a>
        </div>
        <nav
            id="site-header--utility-nav"
            class="utility-menu accessible-menu"
            data-menu-has-items-selector=".menu-item-has-children > a"
        >
            <ul class="menu justify-content-end">
                <li class="menu-item"><a href="#">Link 1 <i class="fa-regular fa-square-arrow-up-right" aria-hidden="true"></i></a></li>
                <li class="menu-item"><a href="#">Link 2 <i class="fa-regular fa-square-arrow-up-right" aria-hidden="true"></i></a></li>
                <li class="menu-item"><a href="#">Link 3 <i class="fa-regular fa-square-arrow-up-right" aria-hidden="true"></i></a></li>
                <li class="menu-item d-none d-md-block">
                    <a href="#"><span class="visually-hidden">Search</span><i class="far fa-search" aria-hidden="true"></i></a>
                </li>
            </ul>
        </nav>
        <div id="site-header--site-navbar" class="row">
            <div id="site-header--site-title" class="col col-md-auto d-flex ">
                <div class="h1 flex-grow-1"><a href="{{ site_homepage_url }}">{{ site_title }}</a></div>
                <div class="d-md-none">
                    <button class="btn btn-light">
                        <span class="visually-hidden">{{ __('Menu', 'bc-sitka-spruce') }}</span>
                        <i class="fas fa-bars" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
            <nav
                id="site-header--main-nav"
                aria-label="{{ __('Main Menu', 'bellevue_2022') }}"
                class="col-md-auto flex-grow-1 main-menu accessible-menu"
                data-item-open-text="{{ __('Open the %s menu', 'bellevue_2022') }}"
                data-item-close-text="{{ __('Close the %s menu', 'bellevue_2022') }}"
                data-menu-has-items-selector=".menu-item-has-children > a"
            >
                {{ menu }}
            </nav>
            <div id="site-header--cta" class="col-md-2 text-md-end">
                {#  Move to a component #}<a class="btn btn-info" href="#">Apply Now!</a>
            </div>
        </div>
        <div id="site-header--search" class="">
            {% include '/stories/site-search-form/site-search-form.twig' %}
        </div>
    </header>
</div>