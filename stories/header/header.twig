<div class="visually-hidden-focusable container-fluid bg-primary py-2">
	<a class="btn btn-outline-light" href="#main-content">Skip to content</a>
</div>
{% include '@stories/sitewide-notice/sitewide-notice.twig' %}
<header id="header-wrapper" class="header-wrapper">
	<div
		id="site-header"
		class="site-header container-xl
			{% if search_expanded %}search-expanded{% endif %}
			{% if menu_expanded %}menu-expanded{% endif %}
	">
		<div id="site-header--logo" class="">
			<a href="{{ core_homepage_url }}"><img class="img-fluid" src="{{ logo_url }}" alt="{{ __('Bellevue College - Link to college homepage', 'bc-sitka-spruce') }}"></a>
		</div>
		<div id="site-header--site-navbar" class="row">
			<div id="site-header--site-title" class="col col-lg-auto d-flex">
				<div class="site-title h4 flex-grow-1 mt-2"><a href="{{ site_homepage_url }}">{{ site_title }}</a></div>
				<button
					class="btn btn-link menu-toggle d-lg-none"
					data-bs-toggle="offcanvas"
					data-bs-target="#site-header--offcanvas"
					aria-controls="site-header--offcanvas"
				>
					<span class="visually-hidden">{{ __('Open menu', 'bc-sitka-spruce') }}</span>
					<i class="fas fa-bars" aria-hidden="true"></i>
				</button>
			</div>
			<div id="site-header--menu-column" class="col-lg">
				<div class="offcanvas-lg offcanvas-end" tabindex="-1" id="site-header--offcanvas" aria-labelledby="site-header--offcanvas-label">
					<div class="offcanvas-header justify-content-end">
						<h2 class="offcanvas-title visually-hidden" id="site-header--offcanvas-label">{{ __('Menu', 'bc-sitka-spruce') }}</h2>
						<button
							type="button"
							class="btn btn-sm btn-outline-primary"
							data-bs-dismiss="offcanvas"
							data-bs-target="#site-header--offcanvas"
						>
							{{ __('Close Menu', 'bc-sitka-spruce') }} <i class="fa-sharp fa-solid fa-arrow-right"></i>
						</button>
					</div>
					<div class="offcanvas-body">
						<nav id="site-header--menu-wrapper" class="flex-grow-1" aria-label="{{ __('Main Menu', 'bc-sitka-spruce') }}">
							<div
								id="site-header--main-nav"
								class="main-menu accessible-menu"
								data-item-open-text="{{ __('Open the %s menu', 'bc-sitka-spruce') }}"
								data-item-close-text="{{ __('Close the %s menu', 'bc-sitka-spruce') }}"
								data-menu-has-items-selector=".menu-item-has-children > a"
							>
								{{ menu }}

							</div>
							<div id="site-header--cta" class="cta-menu accessible-menu">
								{{ menu_cta }}
							</div>
						</nav>
						<nav
							id="site-header--utility-nav-mobile"
							class="utility-menu accessible-menu d-lg-none"
							data-menu-has-items-selector=".menu-item-has-children > a"
						>
							<ul class="menu justify-content-end">
								{% include '@views/static-content/menu-utility.twig' with { li_class: 'menu-item' } %}
							</ul>
						</nav>
						<div class="site-header--search d-lg-none">
							{% include '@stories/site-search-form/site-search-form.twig' with {
								search_field_id: 'college-search-field-mobile',
								search_submit_id: 'college-search-submit-mobile'
							} %}
						</div>
					</div>
				</div>
			</div>
		</div>
		<nav
			id="site-header--utility-nav"
			class="utility-menu accessible-menu d-none d-lg-block"
			data-menu-has-items-selector=".menu-item-has-children > a"
		>
			<ul class="menu justify-content-end">
				{% include '@views/static-content/menu-utility.twig' with { li_class: 'menu-item' } %}
				<li class="menu-item d-none d-lg-block search-toggle">
					<a
						id="site-header--search-toggle-btn"
						href="#"
						class="button-toggle"
						data-button-open-class="search-expanded"
						data-button-open-class-element="header"
						aria-expanded="false"
						aria-controls="college-search-field"
					>
						<span class="visually-hidden">{{ __('Search', 'bc-sitka-spruce') }}</span><i class="far fa-search" aria-hidden="true"></i>
					</a>
				</li>
			</ul>
		</nav>
	</div>
	<div id="site-header--search" class="site-header--search">
		<div class="container-xl">
			{% include '@stories/site-search-form/site-search.twig' %}
		</div>
	</div>
</header>
