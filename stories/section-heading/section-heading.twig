{#
/**
 * @file
 * Bellevue include to display a section lead in.
 */
#}


{%
  set section_heading_classes = [
    'section-heading',
  ]|merge(classes|default([]))
%}

{%
  set applied_link_classes = [
    'link-arrow',
  ]|merge(link_classes|default([]))
%}

{% if link_custom or link_field %}
  {% set link %}
  {% if link_custom %}
		{% include '/stories/atoms/links/link-arrow.twig' with {
			link: link_custom,
		} %}
  {% endif %}
  {% endset %}
{% endif %}

<div class="{{ section_heading_classes|join(' ') }}" {% if css_vars %} style="{{ css_vars|join(' ') }}" {% endif %}>
  <div class="container-xl">
    <div class="row">
         {% if eyebrow %}
          <div class="eyebrow">{{ eyebrow }}</div>
        {% endif %}
      <div class="col-sm-12 col-md-9 small-order-1 medium-order-1">
         <h2 {% if anchor %} id="{{ anchor|esc_attr }}" {% endif %} class="section-heading__heading oho-animate oho-animate-single">
          {{ heading }}
        </h2>
      </div>
      {% if subheading %}
        <div class="col-sm-12 col-md-9 wysiwyg small-order-2 medium-order-3">
          <div class="section-heading__subheading">{{ subheading }}</div>
        </div>
      {% endif %}
      {% if link %}
        <div class="col-sm-12 col-md-3 small-order-3 medium-order-2">
          {{ link }}
        </div>
      {% endif %}

    </div>
  </div>

</div>
