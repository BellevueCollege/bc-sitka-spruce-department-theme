<aside class="sidebar-program-information">
	<div class="program-information-section">
		<dl>
			<dt>{{ __( 'Program Type', 'bc-sitka-spruce' ) }}</dt>
			<dd>{{ type }}</dd>

			<dt>{{ __( 'Degree', 'bc-sitka-spruce' ) }}</dt>
			<dd>{{ degree }}</dd>

			<dt>{{ __( 'Duration', 'bc-sitka-spruce' ) }}</dt>
			<dd>{{ duration }}</dd>

			<dt>{{ __( 'Prerequisites', 'bc-sitka-spruce' ) }}</dt>
			<dd>{{ prerequisites }}</dd>
		</dl>
	</div>
	<div class="pathway-information-section">
		<h3 class="card-title-small">{{ __( 'This program is part of our %s BC Pathway(s)', 'bc-sitka-spruce' )|format( pathway_names|join( ', ', ' and ') ) }}</h3>
		<p>{{  __( 'Our BC Pathways provide guidance and structure that will help you land the career of your dreams.', 'bc-sitka-spruce' ) }}</p>
		<ul class="list-unstyled">
			{% for pathway in pathways %}
				<li><a href="{{ pathway.url }}" target="_blank">{{ pathway.title }} <i class="fa-regular fa-square-arrow-up-right"></i></a></li>
			{% endfor %}
		</ul>

		<h3 class="card-title-small">{{ __( 'Focus Areas', 'bc-sitka-spruce' ) }}</h3>
		<p>{{  __( 'Explore ways you can narrow your learning focus within a pathway.', 'bc-sitka-spruce' ) }}</p>
		<ul class="list-unstyled">
			{% for focus_area in focus_areas %}
				<li><a href="{{ focus_area.url }}" target="_blank">{{ focus_area.title }} <i class="fa-regular fa-square-arrow-up-right"></i></a></li>
			{% endfor %}
		</ul>
	</div>
</aside>
