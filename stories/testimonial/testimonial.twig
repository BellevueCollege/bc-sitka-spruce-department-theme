{#
/**
 * @file
 * Bellevue template for the callout component.
 */
#}

<section class="section section-xlight testimonial-section-wrapper">
	{% include '/stories/section-heading/section-heading.twig' with {
		'heading': title,
		'subheading': description
	} %}
	<div class="testimonial-section container-xl">

		<div class="testimonial row">
			<div class="col-md-6 testimonial-image">
				{{ image }}
			</div>

			<div class="col-md-6 testimonial-text">
				<blockquote>{{ quote }}</blockquote>
				<hr />
				<p class="attribution-name">{{ attribution_name }}</p>
				<p class="attribution-desc">{{ attribution_desc }}</p>
				{%  if cta %}
					<div class="cta">
						<a class="btn btn-primary" {% if cta.target %} target="{{ cta.target }}" {% endif %} href="{{ cta.url }}">
							{{ cta.title }}
							{% if cta.target %}
								<span class="visually-hidden"> {{ __('Opens in a new tab', 'bc-sitka-spruce') }}</span>
								<i class="fa fa-external-link-square text-white ms-2" aria-hidden="true"></i>
							{% endif %}
						</a>
					</div>
				{% endif %}
			</div>
		</div>
	</div>
</section>
