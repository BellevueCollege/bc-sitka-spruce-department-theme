{#
/**
 * @file
 * Minimal segment fixture for section adjacency testing (only used in Storybook, not WordPress)
 */
#}
{% if type == 'arch' %}
  <div class="{{ classes }}"></div>
{% elseif type == 'tabcordionTabs' %}
  <div class="tab-wrapper container-xl">
    <div class="wp-block-bc-sitka-spruce-tabcordion tabcordion tabcordion-tabs card">
      <div class="tab-header d-none d-md-block card-header">
        <ul class="nav nav-tabs card-header-tabs" role="tablist">
          <li class="nav-item active show" role="presentation">
            <a class="nav-link active show" href="#" role="tab">Tab 1</a>
          </li>
          <li class="nav-item" role="presentation">
            <a class="nav-link" href="#" role="tab">Tab 2</a>
          </li>
        </ul>
      </div>
      <div class="col accordion px-md-0">
        <div class="tab-content">
          <div class="tab-pane active show" role="tabpanel">
            <p class="mb-0 fw-semibold">Tabs tabcordion panel stub</p>
          </div>
        </div>
      </div>
    </div>
  </div>
{% elseif type == 'announcement' %}
  {# WordPress wraps the block; without this, .section:has(+ .announcement) adjacency rules misfire in Storybook. #}
  <div class="wp-block-bc-sitka-spruce-announcement-banner">
    {% include '@stories/announcement-banner/announcement-banner.twig' with {
      title: title,
      description: description,
      image: null,
      button: null,
      links: null,
    } %}
  </div>
{% elseif type == 'blockWrapper' %}
  <div class="block-wrapper">
    <p class="fw-semibold mb-0 container-xl">{{ label }}</p>
  </div>
{% else %}
  <section class="{{ classes }}">
    {% if withSectionHeading|default(false) %}
      {% if wrapInnerClass|default('') %}
        <div class="{{ wrapInnerClass }}">
      {% endif %}
      {% set heading_classes = ['mb-4'] %}
      {% if labelClasses == 'text-white' %}
        {% set heading_classes = heading_classes|merge(['text-white', 'dark-bg']) %}
      {% endif %}
      {% include '@stories/section-heading/section-heading.twig' with {
        heading: heading|default(label),
        subheading: subheading|default('<p>Subheading</p>'),
        eyebrow: eyebrow|default(''),
        classes: heading_classes,
      } %}
      {% if showContentStub|default(false) %}
        <div class="container-xl mb-0">
          <p class="fw-semibold mb-0{{ labelClasses ? ' ' ~ labelClasses : '' }}">{{ contentLabel|default('Content below heading') }}</p>
        </div>
      {% endif %}
      {% if wrapInnerClass|default('') %}
        </div>
      {% endif %}
    {% else %}
      <div class="{{ innerClass|default('container-xl') }}">
        <p class="fw-semibold mb-0{{ labelClasses ? ' ' ~ labelClasses : '' }}">{{ label }}</p>
      </div>
    {% endif %}
    {% if showDivider %}
      <hr class="section-divider" />
    {% endif %}
  </section>
{% endif %}
