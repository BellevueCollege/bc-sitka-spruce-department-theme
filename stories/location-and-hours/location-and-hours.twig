<div class="location-and-hours card text-bg-info">
	{% if image %}
		<img class="card-img-top" src="{{ image.src }}" alt="{{ image.alt }}">
	{% endif %}
	<div class="card-body">
		<h2>{{ __('Location', 'bc-sitka-spruce') }}</h2>
		{{ location }}
		{%  if hours %}
			<h2>{{ __('Hours', 'bc-sitka-spruce') }}</h2>
			{{ hours }}
		{% endif %}
		{% if contact_url %}
			<a class="btn btn-primary" href="{{ contact_url }}">{{ __('Contact Information', 'bc-sitka-spruce') }}</a>
		{% endif %}
	</div>
</div>