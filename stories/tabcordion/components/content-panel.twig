<div
	class="tab-pane {{ active }} accordion-item"
	id="{{ title|sanitize }}-content"
	role="tabpanel"
	aria-labelledby="{{ title|sanitize }}-tab"
>
	<h3 class="accordion-header d-md-none" id="{{ title|sanitize }}--acc-header">
		<button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#{{ title|sanitize }}-acc-content" aria-expanded="false" aria-controls="{{ title|sanitize }}--acc-content">
			{{ title }}
		</button>
	</h3>
	<div id="{{ title|sanitize }}-acc-content" class="accordion-collapse collapse d-md-block" aria-labelledby="{{ title|sanitize }}--acc-header" data-bs-parent="#support-feature-accordion">
		<h3 class="d-none d-md-block visually-hidden">{{ title }}</h3>
		<div class="accordion-body">
			{% block content %}
				{{ content }}
			{% endblock %}
		</div>
	</div>
</div>
