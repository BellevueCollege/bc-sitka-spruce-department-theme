<li class="nav-item" role="presentation">
	<a
		class="nav-link {{ active }}"
		id="{{ title|sanitize }}-tab"
		data-bs-toggle="tab"
		data-bs-target="#{{ title|sanitize }}-content"
		aria-controls="{{ title|sanitize }}-content"
		aria-selected="{{ aria_selected }}"
		href="#"
	>{{ title }}</a>
</li>
