{#
/**
* @file
* Bellevue template for the tabcordion component.
*/
#}
{% block wrapperBefore %}{% endblock %}
<div class="row tabcordion oho-animate-sequence oho-animate--in dark-bg">
  <div class="col-md-6 left-pane">
    {% block heading %}
      <h2 class="oho-animate fade-in-down oho-animate--in">{{ heading_text }}</h2>
      <p class="oho-animate fade-in-down oho-animate--in">{{ intro_text }}</p>
    {% endblock %}
    <ul class="nav flex-column d-none d-md-block" role="tablist">
      {% block tabLoop %}
        {% for tab in tabs %}
          {% if loop.first %}
            {% set active = 'active' %}
            {% set ariaSelected = 'true' %}
          {% else %}
            {% set active = '' %}
            {% set ariaSelected = 'false' %}
          {% endif %}
          <li class="nav-item" role="presentation">
            <button
              class="btn btn-primary {{ active }}"
              id="{{ tab.title|sanitize }}-tab"
              data-bs-toggle="tab"
              data-bs-target="#{{ tab.title|sanitize }}-content"
              type="button"
              role="tab"
              aria-controls="{{ tab.title|sanitize }}-content"
              aria-selected="{{ ariaSelected }}"
            >{{ tab.title }} <span aria-hidden="true" class="far fa-long-arrow-right"></span></button>
          </li>
        {% endfor %}
      {% endblock %}
    </ul>
  </div>
  <div class="col accordion px-md-0">
    <div class="tab-content" id="support-feature-accordion">
      {% block contentLoop %}
        {% for tab in tabs %}
          {% if loop.first %}
            {% set active = 'active show' %}
          {% else %}
            {% set active = '' %}
          {% endif %}
          <div
            class="tab-pane fade {{ active }} accordion-item"
            id="{{ tab.title|sanitize }}-content"
            role="tabpanel"
            aria-labelledby="{{ tab.title|sanitize }}-tab"
          >
            <h2 class="accordion-header d-md-none" id="{{ tab.title|sanitize }}--acc-header">
              <button class="accordion-button collapsed bg-primary text-white" type="button" data-bs-toggle="collapse" data-bs-target="#{{ tab.title|sanitize }}-acc-content" aria-expanded="false" aria-controls="{{ tab.title|sanitize }}--acc-content">
                {{ tab.title }}
              </button>
            </h2>
            <div id="{{ tab.title|sanitize }}-acc-content" class="accordion-collapse collapse d-md-block" aria-labelledby="{{ tab.title|sanitize }}--acc-header" data-bs-parent="#support-feature-accordion">
              <div class="accordion-body py-3 py-md-0">
                {% block content %}
                  {{ tab.content }}
                {% endblock %}
              </div>
            </div>
          </div>
        {% endfor %}
      {% endblock %}
    </div>
  </div>
</div>
{% block wrapperAfter %}{% endblock %}
