{#
/**
 * @file
 * Bellevue template for the news feature component.
 */
#}

<section class="news-feature global-margin--12x oho-animate-sequence">
    {% include '/stories/section-heading/section-heading.twig' %}

    <div class="container-xl">
        {% if featured_news and featured_news.title and featured_news.summary and featured_news.image %}
            {% include '/stories/news-feature/news-feature-featured.twig' with {
                image: featured_news.image,
                url: featured_news.link,
                title: featured_news.title,
                summary: featured_news.summary
            } %}
        {% endif %}
        <div class="row mt-4">
            {% for post in news_listing %}
                {% include '/stories/news-feature/news-feature-list-item.twig' with {
                    url: post.link,
                    title: post.title,
                    summary: post.summary,
                } %}
            {% endfor %}
        </div>

    </div>
</section>

