<section class="card border-0 mb-5 card--checkerboard">
	<div class="row g-xl-5">
		<div class="col-md-5 col-lg-7 card-img--checkerboard">
			<figure>
				{% if video and image %}
					<div class="aspect-ratio-frame" style="--aspect-ratio: .74">
						<a class="video-overlay" data-fancybox href="{{ video|esc_url }}" target="_blank">
							{{ image }}
							{% include '/stories/play-button/play-button.twig' %}
							<span class="visually-hidden">{{ __('Click to play video', 'bc-sitka-spruce') }}</span>
						</a>
					</div>
				{% elseif image %}
					<div class="aspect-ratio-frame" style="--aspect-ratio: .74">
						{{ image }}
					</div>
				{% endif %}
				{% if caption %}
					<figcaption>
						{{ caption|e }}
					</figcaption>
				{% endif %}
			</figure>
		</div>

		<div class="col">
			<div class="card-body p-0 p-sm-auto">
				<h3 class="h3">{{ title|e }}</h3>
				{% if text %}
					{{ text|wp_kses_post }}
				{% endif %}
				<div class="checkerboard__links mt-3">
					{% if links %}
						<ul class="link">
							{% for link in links %}
								{% if link.title and link.url %}
									<li>
										{% include '/stories/atoms/links/link-arrow.twig' %}
									</li>
								{% endif %}
							{% endfor %}
						</ul>
					{% endif %}
				</div>
			</div>
		</div>
	</div>
</section>
