<section class="card border-0 card--checkerboard">
	<div class="row g-xl-5">
		<div class="col-md-5 col-lg-7 card-img--checkerboard">
			<figure>
				{% if video and image %}
					<div class="aspect-ratio-frame image-overlay-wrapper" style="--aspect-ratio: .74">
						{{ image }}
						<a class="image-overlay" data-fancybox href="{{ video|esc_url }}" aria-label="{{ __('Play video', 'bc-sitka-spruce') }} {{ title|esc_attr }}" title="{{ __('Play video for', 'bc-sitka-spruce') }} {{ title|esc_attr }}">
							<i class="fa-solid fa-circle-play" aria-hidden="true"></i>
						</a>
					</div>
				{% elseif image %}
					<div class="aspect-ratio-frame" style="--aspect-ratio: .74">
						{{ image }}
					</div>
				{% endif %}
				{% if caption %}
					<figcaption>
						{{ caption|esc_html }}
					</figcaption>
				{% endif %}
			</figure>
		</div>

		<div class="col">
			<div class="card-body p-0 p-sm-auto">
				<h3 class="h3">{{ title|esc_html }}</h3>
				{% if text %}
					{{ text|wp_kses_post }}
				{% endif %}
				<div class="checkerboard__links mt-3">
					{% if links %}
						<ul class="link">
							{% for link in links %}
								{% if link.title and link.url %}
									<li>
										{% include '@stories/atoms/links/link-arrow.twig' %}
									</li>
								{% endif %}
							{% endfor %}
						</ul>
					{% endif %}
				</div>
			</div>
		</div>
	</div>
</section>
