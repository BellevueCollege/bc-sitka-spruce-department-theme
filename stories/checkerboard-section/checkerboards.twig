{#
/**
 * @file
 * Bellevue template for the checkerboard component.
 */
#}
{% set heading_id = anchor_id ? anchor_id ~ '-title' : null %}

<section 
	class="checkerboard section section-white {{ classes }}"
> 
	{% include '/stories/section-heading/section-heading.twig' with {
		heading: title,
		subheading: description,
		anchor: heading_id
	} only %}

	<div class="checkerboards container-xl mt-5">
		{% for checkerboard in checkerboards %}
			{% if checkerboard.image and checkerboard.title %}
				{% include '/stories/checkerboard-section/checkerboard.twig' with {
					video: checkerboard.video,
					image: checkerboard.image,
					caption: checkerboard.caption,
					title: checkerboard.title,
					text: checkerboard.text,
					links: checkerboard.links,
				} %}
			{% elseif is_preview %}
				<p class="text-danger">{{ __('Add content to this checkerboard section so that it can display!', 'bc-sitka-spruce') }}</p>
			{% endif %}
		{% endfor %}
	</div>
	<hr class="section-divider">
</section>
