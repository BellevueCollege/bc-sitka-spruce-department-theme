<section class="bg-trees-dark flexible-page-intro-wrapper mb-0 {{ not has_header_image ? 'no-header-image' : '' }}">
	{% include '/stories/breadcrumbs/breadcrumbs.twig' %}
	<div class="container-xl flexible-page-intro">
		<div class="row">
			<div class="col intro-text-content">
				<h1>{{ title }}</h1>
				{% if intro_text %}
					<p class="lead">{{ intro_text }}</p>
					{% elseif subtitle %}
                    <p class="lead mb-0">{{ subtitle }}</p>
				{% endif %}
			</div>
			{% if header_image %}
				<div class="col-md-6">
					<div class="flexible-page-header-image">
						{{ header_image }}
					</div>
				</div>
			{% endif %}
		</div>
	</div>
</section>
