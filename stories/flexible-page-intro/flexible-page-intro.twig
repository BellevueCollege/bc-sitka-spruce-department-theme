
<section class="bg-trees-dark flexible-page-intro-wrapper {{ not has_header_image ? 'no-header-image' : '' }}">
	{% include '@stories/breadcrumbs/breadcrumbs.twig' %}
	<div class="container-xl flexible-page-intro">
		<div class="row">
			<div class="col intro-text-content">
				<h1>{{ title }}</h1>
				{% if intro_text or subtitle %}
					<p class="lead my-0">
						{{ intro_text }}
						{{ subtitle }}
					</p>
				{% endif %}
			</div>
			{% if header_image %}
				<div class="col-md-6">
					<div class="flexible-page-header-image">
						{{ header_image }}
					</div>
				</div>
			{% endif %}
		</div>
	</div>
</section>
