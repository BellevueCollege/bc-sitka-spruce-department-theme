{%  if links|length > 0 %}
	<p>
		{% for link in links %}
			{% if link.title %}
				<a class="link-arrow" href="{{ link.url|esc_url }}">{{ link.title|e }}</a>
			{% elseif is_preview and link %}
				<p class="text-danger">Notice: Link is missing title and will not be displayed!<p>
			{% endif %}
		{% endfor %}
	</p>
{% endif %}
{% if button and button.title %}
	<a class="btn btn-primary" href="{{ button.url|esc_url }}">{{ button.title|e }}</a>
{% elseif is_preview and button %}
	<p class="text-danger">Notice: Button is missing title and will not be displayed!</p>
{% endif %}
