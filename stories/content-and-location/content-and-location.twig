<section {{ wrapper_attrs }}>
    <div class="row">
        <div class="col">
            <h1 class="content-and-location-heading">{{ heading }}</h1>
			{% if parent_division and site_type != 'div' %}
				<p class="fw-bold">{{ __( "Located within:", "bc-sitka-spruce" ) }} <a class="link-accent" href="{{ parent_division.url }}">{{ parent_division.title }}</a></p>
			{% endif %}
            <p class="content-and-location-summary lead">{{ summary }}</p>
            {{ content }}
        </div>
        {% if display_location %}
            <div class="col-lg-4 col-md-5">
                {%  include '/stories/location-and-hours/location-and-hours.twig' with {
                } %}
            </div>
        {% endif %}
    </div>
</section>
