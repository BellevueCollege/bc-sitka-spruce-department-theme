<div class="contact-item">
	<div class="contact-item-r row">
		<div class="contact-item col-6">
			<h3 class="card-title-small">{{ first_name }}
				{{ last_name }}</h3>
			<p class="position-text">{{ position }}</p>
		</div>
		<div class="contact-info col-6 ">
			{% if phone %}
				<p>
					<i class="fas fa-phone-flip" aria-hidden="true"></i>&nbsp;<a href="tel:{{ phone }}">{{ phone }}</a>
				</p>
			{% endif %}
			{% if email %}
				<p class="contact-info-email">
					<i class="fas fa-envelope" aria-hidden="true"></i>&nbsp;<a href="mailto:{{ email }}">{{ email }}</a>
				</p>
			{% endif %}
			{% if scheduling_link and scheduling_link.title and scheduling_link.url %}
				<p>
					<a class="btn btn-primary" {% if scheduling_link.target %} target="{{ scheduling_link.target }}" {% endif %} href="{{ scheduling_link.url|esc_url }}">
						{{ scheduling_link.title|e }}
						{% if scheduling_link.target %}
							<span class="visually-hidden">{{ __('Opens in a new tab', 'bc-sitka-spruce') }}</span>
							<i class="fa fa-external-link-square" aria-hidden="true"></i>
						{% endif %}
					</a>
				</p>
			{% endif %}
		</div>
	</div>
</div>
