<div class="contact-item-wrapper">
	<div class="contact-item-r row">
		<div class="contact-name col-6">
			<h3 class="card-title-small">{{ first_name }}
				{{ last_name }}</h3>
			<p class="position-text">{{ position }}</p>
		</div>
		<div class="contact-info col-6 ">
			{% if phone %}
				<p>
					<i class="fas fa-phone-flip" aria-hidden="true"></i>&nbsp;<a href="tel:{{ phone }}">{{ phone }}</a>
				</p>
			{% endif %}
			{% if email %}
				<p class="contact-info-email">
					<i class="fas fa-envelope" aria-hidden="true"></i>&nbsp;<a href="mailto:{{ email }}">{{ email }}</a>
				</p>
			{% endif %}
			{% if scheduling_link and scheduling_link.title and scheduling_link.url %}
				<p>
					{% include '@stories/atoms/links/link-button.twig' with { link: scheduling_link } %}
				</p>
			{% endif %}
		</div>
	</div>
</div>
