<form
	action="/search-results/"
	method="get"
	role="search"
	aria-label="{{ __('Search Site', 'bc-sitka-spruce') }}"
	class="site-search-form"
>
	<div class="form-item">
		<label for="{{ search_field_id|default('college-search-field') }}" class="visually-hidden">{{ __('Search Bellevue College', 'bc-sitka-spruce') }}</label>
		<input
			id="{{ search_field_id|default('college-search-field') }}"
			class="form-text"
			type="search"
			placeholder="{{ __('Search bellevuecollege.edu', 'bc-sitka-spruce') }}"
			name="txtQuery"
			value=""
			size="60"
			maxlength="128"
		>
		<button
			id="{{ search_submit_id|default('college-search-submit') }}"
			class="btn btn-primary js-form-submit form-submit"
			type="submit"
		>
			{{ __('Go', 'bc-sitka-spruce') }}
		</button>
	</div>
</form>