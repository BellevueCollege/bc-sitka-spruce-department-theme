{% extends '/stories/tabcordion/components/content.twig' %}

{% block panels %}
	{% for tab in tabs %}
		{% include '/stories/support-feature/support-feature-content-panel.twig' with {
			active: 'active show',
			title: tab.title,
			heading: tab.heading,
			image: tab.image,
			content: tab.content,
			links: tab.links
		} %}
	{% endfor %}
{% endblock %}
