{% extends '/stories/tabcordion/components/content-panel.twig' %}

{% block content %}
	{{ image }}
	<h4 class="h2 mt-3">{{ heading }}</h4>
	{{ content }}
	{% if links %}
		<div class="mt-3">
			{% for link in links %}
				<a class="btn btn-light" href="{{ link.url }}">{{ link.title }}</a>
			{% endfor %}
		</div>
	{% endif %}
{% endblock %}
