{% extends '/stories/tabcordion/components/content-panel.twig' %}

{% block content %}
	{{ image }}
	<h4 class="h2 mt-3">{{ heading }}</h4>
	{{ content }}
	{% if links %}
		<div class="btn-group">
			{% for link in links %}
				{% include '@stories/atoms/links/link-button.twig' with {
					linkClass: 'btn',
				} %}
			{% endfor %}
		</div>
	{% endif %}
{% endblock %}
