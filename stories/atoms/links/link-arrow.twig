
{% set samePageIcon = samePageIcon|default( 'fa-regular fa-arrow-right-long' ) %}
{% set newPageIcon = newPageIcon|default( 'fa-solid fa-square-arrow-up-right' ) %}
{% set linkClass = linkClass|default( 'link-accent-lg' ) %}
{% set iconClass = iconClass|default( '' ) %}
{% set safe_url = link.url|default('')|esc_url %}
{% set is_new_tab = link.target is defined and link.target == '_blank' %}

{% if link.title and safe_url %}
	<a href="{{ safe_url }}"{% if is_new_tab %} target="_blank" rel="noopener"{% endif %} class="{{ linkClass|esc_attr }}">{{ link.title|esc_html }}{% if is_new_tab %}<span class="visually-hidden">{{ __(' Opens in a new tab', 'bc-sitka-spruce') }}</span><i class="{{ newPageIcon|esc_attr }} {{ iconClass|esc_attr }}" aria-hidden="true"></i>
		{% else %}<i class="{{ samePageIcon|esc_attr }} {{ iconClass|esc_attr }}" aria-hidden="true"></i>{% endif %}</a>
{% endif %}
