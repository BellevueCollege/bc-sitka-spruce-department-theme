{#
/**
 * @file
 * Bellevue template for the callout component.
 */
#}
{% set heading_tag = heading_tag|default('h2') %}
{% set enabled = enabled|default(true) %}
{% set wrapper_classes = wrapper_classes|default('callout-wrapper col') %}
<div class="{{ wrapper_classes }}">
	<aside class="callout text-margin-reset {{ callout_type }}">
		<{{ heading_tag|e('html_attr') }} class="callout__heading card-title-small">{{ title|e }}</{{ heading_tag|e('html_attr') }}>
		<p>{{ text|wp_kses_post }}</p>
		{% if links %}
			<div class="callout__links">
				{% if links is iterable %}
					<ul>
						{% for link in links %}
							{% if link.title and link.url %}
								<li>
									<a href="{{ link.url|esc_url }}" {% if link.target %} target="{{ link.target }}" {% endif %} class="link-arrow">
										{{ link.title|e }}
										{% if link.target %}
											<span class="visually-hidden">{{ __('Opens in a new tab', 'bc-sitka-spruce') }}</span>
										{% endif %}
									</a>
								</li>
							{% endif %}
						{% endfor %}
					</ul>
				{% elseif links %}
					{{ links|wp_kses_post }}
				{% endif %}
			</div>
		{% endif %}
		{% if button and button.title and button.url %}
			<p class="callout__button"><a href="{{ button.url|esc_url }}" {% if button.target %} target="{{ button.target }}" {% endif %} class="btn btn-primary">
				{{ button.title|e }}
				{% if button.target %}
					<span class="visually-hidden">{{ __('Opens in a new tab', 'bc-sitka-spruce') }}</span>
					<i class="fa fa-external-link-square ms-1" aria-hidden="true"></i>
				{% endif %}
			</a></p>
		{% endif %}
	</aside>
</div>
