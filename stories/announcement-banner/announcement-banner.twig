{#
/**
* @file
* Bellevue template for the announcement banner component.
*/
#}
<section class="announcement container-xl">
	<div class="row">
		<div class="col">
			<article class="announcement--item oho-animate oho-animate-single fade-in-up rounded">
				<div class="row">
					{% if image %}
						<div class="announcement__image col-sm-6 col-md-4 col-lg-3">
							<figure class="aspect-ratio-frame" style="--aspect-ratio: 174/260">
							{{ image }}
							</figure>
						</div>
					{% endif %}
					<div class="announcement__text col">
						<h2 class="card-title-big">{{ title }}</h2>
						{{ description }}
						<div class="announcement__button mt-3">
							{% if button %}
								<a class='btn btn-primary' {% if button.target %} target="{{ button.target }}" {% endif %} href="{{ button.url }}">
									{{button.title}}
									{% if button.target %}
										<span class="visually-hidden">({{ __('Opens in a new tab', 'bc-sitka-spruce') }})</span>
										<i class="fa fa-external-link-square text-white ms-2" aria-hidden="true"></i>
									{% endif %}
								</a>
							{% endif %}
						</div>

						{% if links %}
							<ul class="announcement__links list-unstyled row mt-3">
								{% for link in links %}
									<li class="col-auto"><a class="link-arrow" {% if link.target %} target="{{ link.target }}" {% endif %} href="{{ link.url }}">
										{{ link.title }}
										{% if link.target %}
											<span class="visually-hidden">({{ __('Opens in a new tab', 'bc-sitka-spruce') }})</span>
										{% endif %}
									</a></li>
								{% endfor %}
							</ul>
						{% endif %}
					</div>
				</div>
			</article>
		</div>
	</div>
</section>
